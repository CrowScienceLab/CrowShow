{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CrowShow",
  "version": "2.0.0",
  "identifier": "lab.crowscience.crowshow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "CrowShow",
        "width": 548,
        "height": 420,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Crow Science Lab",
    "copyright": "Copyright © 2026 Crow Science Lab",
    "category": "Education",
    "shortDescription": "Offline PDF presentation player for classrooms",
    "longDescription": "CrowShow is an offline PDF presentation and annotation player for classrooms.",
    "resources": {
      "icons/desktop-shortcut.ico": "resources/desktop-shortcut-alpha.ico",
      "vendor/rhwp/": "rhwp/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "languages": ["Korean", "English"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
